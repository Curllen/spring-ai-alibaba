{"nodes": [{"id": "springaialibaba_SpringAIAlibaba", "label": "Spring AI Alibaba (SAA)", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positioned as an AI framework bridging Spring AI's low-level atomic abstractions with enterprise-grade multi-agent application development, deeply integrated with Alibaba Cloud's Bailian ecosystem. Addresses the gap between simple chatbot demos and production-grade multi-agent systems."}, {"id": "springai_SpringAI", "label": "Spring AI", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring community's official open-source AI framework released as 1.0 GA in May 2025. Focuses on low-level atomic capability abstractions (ChatModel, Prompt, RAG, ChatMemory, Tool, MCP) and seamless integration with Spring Boot ecosystem."}, {"id": "springaialibaba_GraphFramework", "label": "Spring AI Alibaba Graph", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed as a Java equivalent of Langgraph to help developers build workflow and multi-agent applications. Key design differentiator from Spring AI: adds higher-level orchestration with pre-built Nodes and simplified State definitions, enabling low-code to high-code agent construction."}, {"id": "bailian_BailianPlatform", "label": "Bailian Platform (\u767e\u70bc\u5e73\u53f0)", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alibaba Cloud's visual AI agent development platform providing model access, RAG knowledge base management, and data vectorization preprocessing capabilities."}, {"id": "langgraph_Langgraph", "label": "Langgraph", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "springai_ChatClient", "label": "ChatClient", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring AI's most core component for building chatbot/single-agent applications. Supports The Augmented LLM pattern by mounting Retrieval, Tools, and Memory as external data and services. Preferred for simple direct agent patterns but degrades when too many tools/context are given to the model."}, {"id": "jmanus_JManus", "label": "JManus", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evolved from an OpenManus replica to an agent development platform. Strategic pivot: recognizing that pure autonomous planning cannot solve deterministic enterprise scenarios, JManus now aims to let users build vertical-domain agents through natural language interaction, with plans to convert generated plans into Spring AI Alibaba engineering projects."}, {"id": "openmanus_OpenManus", "label": "OpenManus", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deepresearch_DeepResearch", "label": "DeepResearch Agent", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deep research agent built on Spring AI Alibaba Graph with tools like Web Search, Crawling, and Python script engine to help users complete in-depth research reports."}, {"id": "nacos_NacosMCPRegistry", "label": "Nacos MCP Registry", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "higress_HigressAIGateway", "label": "Higress AI Gateway", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arms_ARMS", "label": "Alibaba Cloud ARMS", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "langfuse_Langfuse", "label": "Langfuse", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "opentelemetry_OpenTelemetry", "label": "OpenTelemetry", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mcp_ModelContextProtocol", "label": "Model Context Protocol (MCP)", "file_type": "document", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_RetrievalAugmentedGeneration", "label": "Retrieval-Augmented Generation (RAG)", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "augmentedllm_TheAugmentedLLM", "label": "The Augmented LLM", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A design pattern from Anthropic's 'Building Effective AI Agents' article. Allows models to access external data (RAG), tools, and memory during inference. Augments raw LLM capabilities with domain-specific data and external API integration."}, {"id": "anthropic_Anthropic", "label": "Anthropic", "file_type": "document", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bailian_BailianRAGKnowledgeBase", "label": "Bailian RAG Knowledge Base", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bailian_BailianXiyanChatBI", "label": "Bailian Xiyan ChatBI (\u6790\u8a00)", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "springaialibaba_Nl2sqlModule", "label": "Spring AI Alibaba Nl2sql Module", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dify_Dify", "label": "Dify", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planact_PLANACTMode", "label": "PLAN-ACT Mode", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent execution pattern enabling complex reasoning, step-by-step execution, and dynamic adjustment. Suitable for multi-turn dialogue, complex decision-making, and automated workflow scenarios."}, {"id": "agentscope_AgentScope", "label": "AgentScope", "file_type": "code", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chatbot_ChatBotPattern", "label": "ChatBot Pattern (Single Agent)", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The simplest AI agent development pattern: give all tools and context to a single model and let it decide and iterate until completion. Ideal in theory but degrades when too many tools/context are provided, causing models to deviate from expected behavior."}, {"id": "workflow_WorkflowPattern", "label": "Workflow Pattern", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deterministic task decomposition pattern where humans pre-define branching flows. Models act as classification/decision nodes within fixed pipelines. Strengths: high determinism, good for intent recognition. Weaknesses: requires deep business understanding, underutilizes model reasoning, criticized as 'not intelligent enough'."}, {"id": "multiagent_MultiAgentPattern", "label": "Multi-Agent Pattern", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task decomposition approach where multiple sub-agents communicate and collaborate with more autonomy and flexibility than workflows. Follows specific communication models (e.g., ReAct Agent, Supervisor) while retaining decision-making freedom within each agent."}, {"id": "react_ReActAgent", "label": "ReAct Agent Pattern", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supervisor_SupervisorPattern", "label": "Supervisor Agent Pattern", "file_type": "rationale", "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "springaialibaba_SpringAIAlibaba", "target": "springai_SpringAI", "relation": "extends", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "weight": 1.0}, {"source": "springaialibaba_SpringAIAlibaba", "target": "bailian_BailianPlatform", "relation": "integrates_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "weight": 1.0}, {"source": "springaialibaba_GraphFramework", "target": "langgraph_Langgraph", "relation": "design_inspired_by", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "weight": 1.0}, {"source": "springaialibaba_GraphFramework", "target": "springaialibaba_SpringAIAlibaba", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": null, "weight": 1.0}, {"source": "springai_ChatClient", "target": "springai_SpringAI", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/test/resources/reader/springaialibaba.txt", "source_location": n