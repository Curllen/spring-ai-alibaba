{
  "nodes": [
    {
      "id": "readme_subagent_tasktool_pattern",
      "label": "Subagent (TaskTool) Pattern",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Delegates complex work to specialized sub-agents for separation of concerns; the main orchestrator agent focuses on coordination and planning while sub-agents provide deep domain expertise in specific areas (codebase exploration, web research, dependency analysis)."
    },
    {
      "id": "readme_tech_due_diligence_assistant",
      "label": "Tech Due Diligence Assistant (Orchestrator)",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A multi-agent system that helps evaluate software projects by combining codebase analysis (structure, dependencies, patterns, technical debt) with web research (documentation, alternatives, benchmarks, ecosystem). Uses write_todos for planning and Task/TaskOutput tools for delegation."
    },
    {
      "id": "readme_task_tools",
      "label": "Task / TaskOutput Delegation Tools",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Task tool initiates delegation of a unit of work to a specialized sub-agent; TaskOutput tool receives the result. Together they form a request-response delegation protocol that decouples the orchestrator from sub-agent implementation details."
    },
    {
      "id": "readme_write_todos",
      "label": "write_todos Planning Tool",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enables structured task planning by breaking complex due diligence tasks into smaller, trackable steps before delegation. Injected by TodoListInterceptor into the orchestrator agent."
    },
