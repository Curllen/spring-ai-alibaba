    {
      "id": "readme_markdown_agent_definition",
      "label": "Markdown-based Agent Definition",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Declarative, file-based definition for simplicity and ease of authoring. Agent specs stored as Markdown files with YAML front matter containing name, description, and comma-separated tools list. Registered via TaskToolsBuilder.addAgentResource() or addAgentDirectory(). Trade-off: simple and readable but limited to declarative configuration."
    },
    {
      "id": "readme_api_agent_definition",
      "label": "API-based (Programmatic) Agent Definition",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/subagent/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Programmatic definition via ReactAgent.builder() for maximum flexibility: custom system prompts, dynamic tool selection, and Java-level configuration. Registered via TaskToolsBuilder.subAgent(). Trade-off: more complex to define but offers fine-grained control over agent behavior."
    },
