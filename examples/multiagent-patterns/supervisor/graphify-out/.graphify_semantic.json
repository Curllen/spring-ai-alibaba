    {
      "id": "readme_supervisor_pattern",
      "label": "Supervisor Pattern",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L3-L4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Central supervisor coordinates specialized agents by calling them as tools. This decouples routing logic from domain execution, enabling single-domain and multi-domain delegation with a unified user-facing interface."
