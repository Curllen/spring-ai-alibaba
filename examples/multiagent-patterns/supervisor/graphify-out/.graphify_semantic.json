    {
      "id": "readme_stateless_agents_design",
      "label": "Stateless Specialized Agents",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L16",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Specialized agents are stateless from the user's perspective. The supervisor keeps the conversation context and delegates one-off tasks. Each agent runs in a focused context with its own instruction plus the request string, avoiding shared-state complexity."
    },
    {
      "id": "readme_string_input_type_design",
      "label": "String InputType Design",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L24-L27",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Each specialized agent uses inputType(String.class): the supervisor passes a single natural-language request string, and the framework wraps it as the tool's input parameter. This simplifies the tool interface to a single-string contract."
    },
    {
      "id": "readme_tool_per_agent_design",
      "label": "Tool-per-Agent Design",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L28-L29",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "One tool per specialized agent (schedule_event, manage_email) provides clear routing and self-documenting tool descriptions. The supervisor only sees high-level tools without needing to understand internal agent toolchains."
    },
    {
      "id": "readme_stub_apis_design",
      "label": "Stub APIs Pattern",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L31-L32",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Calendar and email API calls are stubbed (CalendarStubTools, EmailStubTools) for demonstration. In production these would be replaced with real integrations. This allows testing the agent coordination pattern without external service dependencies."
    },
    {
      "id": "readme_agent_isolation_design",
      "label": "Agent Isolation",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L16-L17",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Each specialized agent runs in a focused context with its own instruction and tools. Only the final assistant message is shown to the user. This isolation prevents cross-contamination of agent state and simplifies debugging."
    },
    {
      "id": "readme_instruction_input_design",
      "label": "Instruction and Input Type Pattern",
      "file_type": "rationale",
      "source_file": "examples/multiagent-patterns/supervisor/README.md",
      "source_location": "L22-L27",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Each specialized agent is configured with a system instruction defining its behavior (e.g. 'You are a calendar scheduling assistant\u2026') and inputType(String.class). This pattern separates agent identity from the supervisor's routing logic."
    },
